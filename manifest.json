{
  "manifest_version": 3,
  "name": "Flik",
  "version": "0.1.2",
  "description": "Visar hur länge sedan du faktiskt använde varje flik.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/flik-16.png", "32": "icons/flik-32.png", "48": "icons/flik-48.png", "128": "icons/flik-128.png" },
  "permissions": ["tabs", "storage", "idle", "alarms", "contextMenus", "scripting", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }],
  "options_page": "options.html",
  "action": { "default_title": "Flik – öppna inställningar", "default_icon": { "16": "icons/flik-16.png", "32": "icons/flik-32.png" } }
}
